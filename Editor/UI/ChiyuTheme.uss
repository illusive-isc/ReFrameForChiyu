
:root {
    --reframe-color-text-dim: rgba(220, 228, 235, 0.85);

    --reframe-color-slate: rgb(170, 150, 156);
    --reframe-color-bundle-accent: rgb(214, 150, 170);
    --reframe-color-bundle-bg: rgba(214, 150, 170, 0.16);

    --reframe-color-blendtree: rgba(170, 150, 156, 0.36);
    --reframe-color-forcedelete: rgba(150, 40, 40, 0.60);
    --reframe-color-requires: rgba(222, 186, 110, 0.40);

    --reframe-color-row-bg: rgba(228, 186, 198, 0.30);
    --reframe-color-row-bg-hover: rgba(238, 204, 214, 0.45);
    --reframe-color-bar-fixed: rgb(124, 108, 114);
    --reframe-color-bar-used: rgb(214, 150, 170);
    --reframe-color-bar-cut: rgb(222, 186, 110);
    --reframe-color-bar-free: rgba(42, 30, 36, 0.7);

    --reframe-color-row-bg-menu-deleted: rgba(150, 96, 116, 0.65);
    --reframe-color-row-bg-gimmick-deleted: rgba(78, 50, 62, 0.82);
    --reframe-color-cascaded-row-bg: rgba(30, 20, 24, 0.90);
    --reframe-radius-row: 9px;
    --reframe-radius-chip: 999px;
    --reframe-radius-checkbox: 4px;

    --reframe-color-category-text: rgb(240, 245, 250);
    --reframe-color-category-border: rgba(228, 186, 198, 0.40);
    --reframe-color-category-border-nested: rgba(228, 186, 198, 0.18);
    --reframe-radius-category: 6px;

    --reframe-color-toggle-checked: rgb(214, 150, 170);
    --reframe-color-field-border: rgba(170, 150, 156, 0.45);

    --reframe-color-toggle-off-bg: rgb(42, 30, 36);
    --reframe-color-toggle-on-text: rgb(46, 24, 32);
    --reframe-color-toggle-off-text: rgb(224, 230, 236);
    --reframe-color-accent-text: rgb(244, 206, 218);

    --reframe-color-panel-bg: rgba(42, 30, 36, 0.55);
    --reframe-color-panel-border: rgba(228, 186, 198, 0.40);
    --reframe-color-panel-text: rgb(240, 245, 250);
    --reframe-color-button-bg: rgb(42, 30, 36);
    --reframe-color-button-text: rgb(224, 230, 236);
    --reframe-color-button-hover-bg: rgb(214, 150, 170);
    --reframe-color-button-hover-text: rgb(46, 24, 32);
    --reframe-color-checkbox-bg: rgb(124, 108, 114);
    --reframe-color-checkbox-border: rgba(240, 245, 250, 0.55);
    --reframe-color-checkbox-checked-bg: rgb(176, 96, 124);
    --reframe-color-checkbox-check: rgb(250, 252, 255);

    --reframe-color-root-bg: rgba(214, 150, 170, 0.14);
    --reframe-radius-root: 8px;

    --reframe-color-locked-bg: rgb(222, 186, 110);
    --reframe-color-locked-text: rgb(40, 30, 16);
}
